; import-linter 配置
;
; 参考：docs/kongming-agent-v1-minimal/10-contracts.md
;
; 依赖方向的核心要求：
;   - 所有模块都可以 import `core`
;   - `core` 不允许 import 任何 sibling 模块
;   - 跨模块共享协议只能来自 `core/contracts.py`
;   - Tool Runtime 不直接 import safety 内部 policy，由运行时装配层组装

[importlinter]
root_packages =
    core
    tools
    sessions
    prompting
    infrastructure
    application
    runtime_assembly
    hosts
    safety
    memory
    prompts
    evolution
    scheduler
    network
source_paths = src
include_external_packages = True

; ---------------------------------------------------------------------------
; Contract 1: core 不允许反向依赖任何 sibling 模块
; ---------------------------------------------------------------------------

[importlinter:contract:core-no-sibling-imports]
name = core must not import sibling modules
type = forbidden
source_modules =
    core
forbidden_modules =
    tools
    sessions
    prompting
    infrastructure
    application
    runtime_assembly
    hosts
    safety
    prompts

; Contract 2（"sessions 不允许重定义 Session Protocol"）由 pytest 架构合约测试
; 实现，见 tests/unit/test_arch_contracts.py::test_sessions_do_not_define_session_protocol
; 原因：import-linter 的 forbidden_modules 不支持 "symbol 级" 禁止
; （typing_extensions.Protocol 是符号，不是子包）。

; ---------------------------------------------------------------------------
; Contract 3: 整体分层依赖方向
;   core < infrastructure.config < infrastructure adapters < domain packages < safety < runtime_assembly < host < cli
; ---------------------------------------------------------------------------

[importlinter:contract:layered-dependency-direction]
name = kongming-agent layered dependency direction
type = layers
layers =
    hosts.cli | hosts.web
    hosts.shared
    application
    runtime_assembly
    safety
    tools
    scheduler
    sessions | prompting
    infrastructure.llm_providers | infrastructure.tracing
    memory
    infrastructure.config
    core
    prompts
containers =
; Exception: 运行时装配层 ``runtime_assembly/native_runtime.py`` 跨层
; 引用 ``safety`` / ``prompting`` 是 v1-mini 的刻意设计——Safety Baseline 和
; HistoryCompactor 默认装配都由它承担（详见 docs/kongming-agent-v1-minimal/
; 10-contracts.md "Native Runtime 边界"）。仅放行真实存在的这两条 import；
; 其他任何跨层 import 仍被合约阻止。
ignore_imports =
    runtime_assembly.native_runtime -> safety
    runtime_assembly.native_runtime -> prompting
    runtime_assembly.native_runtime -> prompting.compaction.history_compactor
    runtime_assembly.native_runtime -> prompting.assembly.input_assembler
    runtime_assembly.native_runtime -> prompting.instructions.instruction_loader
    scheduler.runtime_factory -> runtime_assembly.native_runtime
    scheduler.runtime_factory -> application.scheduled_runs.execution_bridge
    scheduler.ticker -> application.scheduled_runs.execution_bridge
    scheduler.runtime_factory -> sessions
    tools -> scheduler.store
    tools.builtin.schedule_tool -> scheduler.domain
    tools.builtin.schedule_tool -> scheduler.store
    tools.builtin.schedule_tool -> scheduler.schedule_parser
    tools.builtin.schedule_tool -> scheduler.timing
    scheduler.runtime_factory -> sessions.session_bootstrap
    evolution.claude_evidence_selector -> hosts.web.integrations.claude_code.jsonl_history
    runtime_assembly.native_runtime -> evolution
; claude-image-paste-e2e §4/§5：MediaPart Protocol + ImageMediaPart 需要
; 引用 ``hosts.web.uploads.storage::AssetStorage`` (IO 抽象) 与
; ``hosts.web.uploads.registry::EXT_BY_MIME`` (MIME→ext 白名单)。这两个符号是
; domain logic（无 framework 耦合），技术上可以提到 core / prompting 层，
; 但本任务范围不做搬移。spec-media-input §5 设计文档明确：MediaPart 是
; assembly → provider 路径上的中间表示，引用 hosts.web.uploads 是单点白名单。
    infrastructure.llm_providers.media_adapter -> hosts.web.uploads.storage
    infrastructure.llm_providers.media_adapter -> hosts.web.uploads.registry

; ---------------------------------------------------------------------------
; Contract 4: tools 不允许直接 import safety 内部 policy / guards / decision_engine
;             Tool Runtime 只消费装配层串好的高层判定结果
; v0.1.4 扩展：把 safety.guards.* / boundary_resolver / _path_trie /
;            grant_store / _grant_persister / decision_engine 全部加入禁止
; ---------------------------------------------------------------------------

[importlinter:contract:tools-no-direct-safety-policy]
name = tools must not import safety internal policies directly
type = forbidden
source_modules =
    tools
forbidden_modules =
    safety.policies
    safety.policies.capability
    safety.policies.permission
    safety.guards
    safety.guards.hard_block
    safety.guards.consent
    safety.guards.trust
    safety.boundaries
    safety.boundaries.resolver
    safety.boundaries.path_trie
    safety.grants
    safety.grants.store
    safety.grants.persister
    safety.approval.decision_engine

; ---------------------------------------------------------------------------
; Contract 5: hosts.web.protocol 必须零 sibling 依赖
;             协议层是其它模块的契约真源，自身不能反向消费任何内核 / 装配层
; ---------------------------------------------------------------------------

[importlinter:contract:web-protocol-no-deps]
name = hosts.web.protocol must not import any sibling
type = forbidden
source_modules =
    hosts.web.protocol
forbidden_modules =
    core
    tools
    sessions
    prompting
    infrastructure
    application
    runtime_assembly
    hosts.shared
    hosts.cli
    safety
    memory
    prompts

; ---------------------------------------------------------------------------
; Contract 6: web 应用层（app shell）不可 import 跨支柱模块
;             hosts.web.app / hosts.web.routers / hosts.web.websocket.routes / hosts.web.auth* / hosts.web.static / hosts.web.errors
;             / hosts.web.rate_limit 必须只依赖 hosts.web.protocol / hosts.web.threads.manager /
;             hosts.web.app_support.host_adapter / hosts.web.websocket.event_sink / hosts.web.threads.cell /
;             hosts.web.threads.metadata / hosts.web.threads.types / infrastructure.config / 外部库。
;             不可 import core / tools / runtime_assembly / safety / host / cli /
;             sessions / prompting / infrastructure.tracing / memory / prompts。
;
;             v0.1.5 取舍：hosts.web.run / hosts.web.threads.manager / hosts.web.app_support.host_adapter
;             / hosts.web.websocket.event_sink / hosts.web.threads.cell 之类 **装配 entrypoint** 与
;             已存在的 thread_manager 联动模块允许跨支柱（如 thread_cell 需要
;             import core.contracts / runtime_assembly / hosts.shared.session_bridge）；
;             这些路径走全局 layered-dependency-direction（Contract 3）保护。
;
;             本 Contract 6 仅约束 web-app-shell 任务交付的 app shell 层文件
;             —— 它们是 thread-manager 之上的薄装配，应当只依赖协议 + 接口
;             Protocol 而不接触 core / runtime_assembly / host 等支柱细节。
; ---------------------------------------------------------------------------

[importlinter:contract:web-app-shell-no-cross-pillar]
name = web app shell must not import core/tools/runtime_assembly/safety/host/cli/sessions/prompting/infrastructure adapters/memory/prompts
type = forbidden
source_modules =
    hosts.web.app
    hosts.web.auth.middleware
    hosts.web.auth.secrets
    hosts.web.errors
    hosts.web.rate_limit
    hosts.web.static
    hosts.web.threads.types
    hosts.web.websocket.routes
    hosts.web.routers
forbidden_modules =
    core
    tools
    runtime_assembly
    application
    safety
    hosts.shared
    hosts.cli
    sessions
    prompting
    infrastructure.llm_providers
    infrastructure.tracing
    memory
    prompts
; hosts.web.app_support.slash_candidates_loader 是装配期 loader（同 hosts.web.run），
; 仅在 lifespan startup 懒 import，允许触达 prompting / commands。
ignore_imports =
    hosts.web.app -> hosts.web.app_support.slash_candidates_loader
    hosts.web.app -> scheduler.runtime_factory
    hosts.web.app -> scheduler.store
    hosts.web.app -> scheduler.ticker
    hosts.web.app -> scheduler.delivery
    hosts.web.app -> evolution.apply_executor
    hosts.web.app -> evolution.evolution_manager
    hosts.web.routers.threads -> evolution.apply_executor
    hosts.web.routers.threads -> evolution.models
    hosts.web.routers.threads -> evolution.state_store
    hosts.web.routers.threads -> evolution.store
    hosts.web.websocket.routes -> evolution.state_store
    hosts.web.websocket.routes -> evolution.store
    hosts.web.integrations.claude_code.route -> hosts.web.websocket.event_sink
    hosts.web.integrations.claude_code.route -> evolution.claude_transcript_provider
    hosts.web.integrations.claude_code.route -> core.contracts
; hosts.web.routers.uploads -> hosts.web.uploads.{storage,registry,validation}：
; routers/uploads.py 作为 media-upload-shell controller，必须直接消费 storage
; / registry / validator 三件套。hosts.web.uploads 子模块自身依赖 infrastructure.config
; （storage 默认 base_dir 走 ``get_kongming_home()``）和 hosts.web.threads.manager
; （validator 校验 thread 存在）——这些都是合理的领域内依赖，但通过
; ``infrastructure.config.errors -> core.errors`` 与 ``thread_manager -> thread_cell
; -> native_runtime -> host/safety/...`` 的传递链会被 Contract 6 误判为
; routers 跨支柱依赖。单点白名单放行（已在 spec-media-input §5 注明）。
    hosts.web.routers.uploads -> hosts.web.uploads.storage
    hosts.web.routers.uploads -> hosts.web.uploads.registry
    hosts.web.routers.uploads -> hosts.web.uploads.validation
; claude-code-channel-image-paste：claude_code 通道补图片粘贴。
; service.py / _attachment_prefix.py 需要消费 AssetStorage（路径反推） +
; EXT_BY_MIME（mime→ext 白名单单点真源）。同 routers/uploads.py 通过
; ``infrastructure.config.errors -> core.errors`` 传递触发 Contract 6，单点放行。
    hosts.web.integrations.claude_code.service -> hosts.web.uploads.storage
    hosts.web.integrations.claude_code._attachment_prefix -> hosts.web.uploads.storage
; codex-channel-image-paste §3：codex 通道 service + _image_cli_args 消费
; AssetStorage (路径反推) + EXT_BY_MIME (mime→ext 白名单)。同 claude_code 通过
; ``infrastructure.config.errors -> core.errors`` 传递触发 Contract 6，单点放行。
    hosts.web.integrations.codex.service -> hosts.web.uploads.storage
    hosts.web.integrations.codex._image_cli_args -> hosts.web.uploads.storage
    hosts.web.integrations.codex._image_cli_args -> hosts.web.uploads.registry
    hosts.web.integrations.claude_code._attachment_prefix -> hosts.web.uploads.registry
; hosts.web.app -> hosts.web.uploads.{storage,registry,validation}：
; app.py 装配期注入单例到 ``app.state.*``（asset_storage / asset_registry
; / upload_validator），让 routers/uploads.py 优先消费注入的单例而不是
; module-level lazy singleton。同样通过 ``infrastructure.config.errors -> core.errors``
; 传递触发 Contract 6，单点白名单放行（与上方 routers 同理）。
    hosts.web.app -> hosts.web.uploads.storage
    hosts.web.app -> hosts.web.uploads.registry
    hosts.web.app -> hosts.web.uploads.validation
; auto-approval-manager-boundary：app.py 只调用 Web 侧 Manager，真实
; safety.auto_approval 装配由 app_support.auto_approval_manager 内部承担。
; 这是唯一 Web app shell 自动审批装配边，禁止回退到
; hosts.web.approvals.auto -> safety 包级放行。
    hosts.web.app -> hosts.web.app_support.auto_approval_manager
; cli-approval-manager-v0.1：hosts.web.approvals.auto 仅保留 Web WS/audit 边界和
; compatibility exports，policy/config/rules 真源迁到 safety.auto_approval。
; 放行这三条精确 re-export 边，app/routers 继续只通过 hosts.web.approvals.auto 入口触达。
    hosts.web.approvals.auto -> safety.auto_approval.config_store
    hosts.web.approvals.auto -> safety.auto_approval.policy
    hosts.web.approvals.auto -> safety.auto_approval.rules
; manage-config-tab #6：hosts.web.app + dashboard/config/router 都需要触达 manager / writer
; / restart / schema 子模块。其中 writer 走 infrastructure.config.{loader,errors} 做
; pydantic 校验闭环——``infrastructure.config.errors -> core.errors`` 的传递链触发
; Contract 6。dashboard/config 是 task 单点真源（操作 setting.yaml 的唯一入口），
; 与 hosts.web.uploads 同模式单点白名单放行。
    hosts.web.app -> hosts.web.dashboard.config
    hosts.web.dashboard.config.router -> hosts.web.dashboard.config.manager
    hosts.web.dashboard.config.router -> hosts.web.dashboard.config.restart

; ---------------------------------------------------------------------------
; Contract 7: scheduler 不允许 import web 模块
;             scheduler 通过 Protocol（TargetDeliverySink）与 web 解耦；
;             具体实现（ThreadTargetSink）在 web 侧，装配层注入。
; ---------------------------------------------------------------------------

[importlinter:contract:scheduler-no-web]
name = scheduler must not import web
type = forbidden
source_modules =
    scheduler
forbidden_modules =
    hosts.web
; claude-image-paste-e2e §5：scheduler.runtime_factory → native_runtime
; → infrastructure.llm_providers.anthropic_messages → infrastructure.llm_providers.media_adapter
; → hosts.web.uploads.storage 是传递链(media_adapter 的 hosts.web.uploads 白名单已在
; Contract 3 上方注明)。scheduler 本身不直接 import web,这里单点放行透传。
ignore_imports =
    infrastructure.llm_providers.media_adapter -> hosts.web.uploads.storage
    infrastructure.llm_providers.media_adapter -> hosts.web.uploads.registry

; ---------------------------------------------------------------------------
; Contract 8: evolution 不允许 import web 模块
;             evolution 通过 TranscriptProvider Protocol 与频道层解耦；
;             唯一例外：claude_evidence_selector -> hosts.web.integrations.claude_code.jsonl_history
;             （单点白名单，借 jsonl 解析能力）。
; ---------------------------------------------------------------------------

[importlinter:contract:evolution-no-web]
name = evolution must not import web
type = forbidden
source_modules =
    evolution
forbidden_modules =
    hosts.web
ignore_imports =
    evolution.claude_evidence_selector -> hosts.web.integrations.claude_code.jsonl_history
; claude-image-paste-e2e §5：evolution.evolution_manager → native_runtime
; → infrastructure.llm_providers.anthropic_messages → infrastructure.llm_providers.media_adapter
; → hosts.web.uploads.{storage,registry} 是传递链(已在 Contract 3 白名单)。
; evolution 自身不直接 import web,这里单点放行透传。
    infrastructure.llm_providers.media_adapter -> hosts.web.uploads.storage
    infrastructure.llm_providers.media_adapter -> hosts.web.uploads.registry

; ---------------------------------------------------------------------------
; Contract 9: usage-token 封装边界
;             ``hosts.web.usage_token`` 是 Token 用量的唯一对外入口。
;             外部模块禁止 import 内部子模块（_models / _channel_anthropic /
;             _channel_openai / _persistence / _migration），只能通过
;             ``UsageTokenManager`` + 公共 DTO（UsageTokenSnapshot /
;             ThreadUsageSummary / UsageFrame / ThreadMetadataIO）访问。
;
;             5 大硬性约束的机器强制；详见 docs/usage-token/。
;
;             白名单：
;             - ``hosts.web.threads.metadata -> hosts.web.usage_token._migration``
;               task#2 阶段 thread_metadata.py 的 lazy upgrade 链需要单点调用
;               ``upgrade_v7_to_v8`` 纯函数（迁移逻辑沉到 _migration 模块）
; ---------------------------------------------------------------------------

[importlinter:contract:usage-token-encapsulation]
name = Only UsageTokenManager v2 and public DTOs exposed; derivers and private models are forbidden
type = forbidden
; allow_indirect_imports=True：只禁直接 import；透过公共入口 hosts.web.usage.usage_token_v2 →
; manager.py 间接接触内部模型是合法的（manager 内部消费自家私有 helper）。
allow_indirect_imports = True
source_modules =
    core
    hosts.cli
    hosts.shared
    safety
    infrastructure
    application
    runtime_assembly
    hosts.web.app
    hosts.web.routers
    hosts.web.app_support.cron_delivery
    hosts.web.websocket.cron
    hosts.web.websocket.routes
    hosts.web.websocket.event_sink
    hosts.web.threads.metadata
    hosts.web.integrations.claude_code
    hosts.web.integrations.codex
    hosts.web.protocol
forbidden_modules =
    hosts.web.usage.usage_token_v2._derive_claude
    hosts.web.usage.usage_token_v2._derive_codex
    hosts.web.usage.usage_token_v2._derive_generic
    hosts.web.usage.usage_token_v2._models
    hosts.web.usage.usage_token_v2._model_context_table
; hosts.web.threads.manager 是装配层，允许构造 v2 manager + 注入 locator；
; 但仍禁止直接 import 派生器（manager 内部消费）。

; ---------------------------------------------------------------------------
; Contract 10: whiteboard router 不允许绕过 manager 直接 import store
;              router 必须只通过 WhiteboardManager 操作白板数据，
;              store 是内部实现细节，不能成为 router 的直接依赖。
; ---------------------------------------------------------------------------

[importlinter:contract:whiteboard-isolation]
name = Whiteboard router must go through manager
type = forbidden
source_modules =
    hosts.web.routers.whiteboard
forbidden_modules =
    hosts.web.whiteboard.store
; router → manager → store 是合法链路，只禁直接 import
allow_indirect_imports = True

; ---------------------------------------------------------------------------
; Contract 11: network 不依赖业务层
;              network 包是基础设施层，业务模块可以 import 它，反向禁止。
;              v0.1 web 是业务层全集；v0.2 接入更多频道时按需扩展。
; ---------------------------------------------------------------------------

[importlinter:contract:network-self-contained]
name = network must not depend on business modules
type = forbidden
source_modules =
    network
forbidden_modules =
    hosts.web

; ---------------------------------------------------------------------------
; Contract 12: network.tools 仅 network 包内部可见
;              业务模块若需要 network 工具，应通过 network.manager /
;              network.heartbeat 的公开接口访问；不要直接 import tools。
; ---------------------------------------------------------------------------

[importlinter:contract:network-tools-private]
name = network.tools is private to network package
type = forbidden
; allow_indirect_imports=True: 业务模块通过 network.manager 公开接口间接触达
; tools（manager 内部消费私有 helper）合法；只禁直接 ``from network.tools import ...``
allow_indirect_imports = True
source_modules =
    core
    tools
    sessions
    prompting
    infrastructure
    application
    runtime_assembly
    hosts.shared
    hosts.cli
    safety
    memory
    prompts
    evolution
    scheduler
    hosts.web
forbidden_modules =
    network.tools
