; import-linter 配置
;
; 参考：docs/kongming-agent-v1-minimal/10-contracts.md
;
; 依赖方向的核心要求：
;   - 所有模块都可以 import `core`
;   - `core` 不允许 import 任何 sibling 模块
;   - 跨模块共享协议只能来自 `core/contracts.py`
;   - Tool Runtime 不直接 import safety 内部 policy，由运行时装配层组装

[importlinter]
root_packages =
    core
    tools
    context
    executors
    host
    cli
    safety
    observability
    config_loader
    memory
    prompts
    evolution
    scheduler
    web
source_paths = src
include_external_packages = True

; ---------------------------------------------------------------------------
; Contract 1: core 不允许反向依赖任何 sibling 模块
; ---------------------------------------------------------------------------

[importlinter:contract:core-no-sibling-imports]
name = core must not import sibling modules
type = forbidden
source_modules =
    core
forbidden_modules =
    tools
    context
    executors
    host
    cli
    safety
    observability
    prompts

; Contract 2（"context 不允许重定义 Session Protocol"）由 pytest 架构合约测试
; 实现，见 tests/unit/test_arch_contracts.py::test_context_does_not_define_session_protocol
; 原因：import-linter 的 forbidden_modules 不支持 "symbol 级" 禁止
; （typing_extensions.Protocol 是符号，不是子包）。

; ---------------------------------------------------------------------------
; Contract 3: 整体分层依赖方向
;   core < (tools / context / executors / observability) < safety < host < cli
; ---------------------------------------------------------------------------

[importlinter:contract:layered-dependency-direction]
name = kongming-agent layered dependency direction
type = layers
layers =
    cli | web
    host
    safety
    tools | context | executors | observability | scheduler
    memory
    config_loader
    core
    prompts
containers =
; Exception: 运行时装配层 ``executors/agent_runtime/native_runtime.py`` 跨层
; 引用 ``safety`` / ``context`` 是 v1-mini 的刻意设计——Safety Baseline 和
; HistoryCompactor 默认装配都由它承担（详见 docs/kongming-agent-v1-minimal/
; 10-contracts.md "Native Runtime 边界"）。仅放行真实存在的这两条 import；
; 其他任何跨层 import 仍被合约阻止。
ignore_imports =
    executors.agent_runtime.native_runtime -> safety
    executors.agent_runtime.native_runtime -> context
    executors.agent_runtime.native_runtime -> context.history_compactor
    executors.agent_runtime.native_runtime -> context.input_assembler
    executors.agent_runtime.native_runtime -> context.instruction_loader
    scheduler.runtime_factory -> executors.agent_runtime.native_runtime
    scheduler.runtime_factory -> context
    scheduler.execution_bridge -> executors.llm.provider_factory
    scheduler.execution_bridge -> observability
    tools -> scheduler.store
    tools.schedule_tool -> scheduler.domain
    tools.schedule_tool -> scheduler.store
    tools.schedule_tool -> scheduler.schedule_parser
    tools.schedule_tool -> scheduler.timing
    scheduler.runtime_factory -> context.session_bootstrap
    evolution.claude_evidence_selector -> web.claude_code.jsonl_history
    executors.agent_runtime.native_runtime -> evolution

; ---------------------------------------------------------------------------
; Contract 4: tools 不允许直接 import safety 内部 policy / guards / decision_engine
;             Tool Runtime 只消费装配层串好的高层判定结果
; v0.1.4 扩展：把 safety.guards.* / boundary_resolver / _path_trie /
;            grant_store / _grant_persister / decision_engine 全部加入禁止
; ---------------------------------------------------------------------------

[importlinter:contract:tools-no-direct-safety-policy]
name = tools must not import safety internal policies directly
type = forbidden
source_modules =
    tools
forbidden_modules =
    safety.capability_policy
    safety.permission_policy
    safety.guards
    safety.guards.hard_block
    safety.guards.consent
    safety.guards.trust
    safety.boundary_resolver
    safety._path_trie
    safety.grant_store
    safety._grant_persister
    safety.decision_engine

; ---------------------------------------------------------------------------
; Contract 5: web.protocol 必须零 sibling 依赖
;             协议层是其它模块的契约真源，自身不能反向消费任何内核 / 装配层
; ---------------------------------------------------------------------------

[importlinter:contract:web-protocol-no-deps]
name = web.protocol must not import any sibling
type = forbidden
source_modules =
    web.protocol
forbidden_modules =
    core
    tools
    context
    executors
    host
    cli
    safety
    observability
    memory
    prompts
    config_loader

; ---------------------------------------------------------------------------
; Contract 6: web 应用层（app shell）不可 import 跨支柱模块
;             web.app / web.routers / web.ws / web.auth* / web.static / web.errors
;             / web.rate_limit 必须只依赖 web.protocol / web.thread_manager /
;             web.host_adapter / web.ws_event_sink / web.thread_cell /
;             web.thread_metadata / web.types / config_loader / 外部库。
;             不可 import core / tools / executors / safety / host / cli /
;             context / observability / memory / prompts。
;
;             v0.1.5 取舍：web.run / web.thread_manager / web.host_adapter
;             / web.ws_event_sink / web.thread_cell 之类 **装配 entrypoint** 与
;             已存在的 thread_manager 联动模块允许跨支柱（如 thread_cell 需要
;             import core.contracts / executors.agent_runtime / host.session_bridge）；
;             这些路径走全局 layered-dependency-direction（Contract 3）保护。
;
;             本 Contract 6 仅约束 web-app-shell 任务交付的 app shell 层文件
;             —— 它们是 thread-manager 之上的薄装配，应当只依赖协议 + 接口
;             Protocol 而不接触 core / executors / host 等支柱细节。
; ---------------------------------------------------------------------------

[importlinter:contract:web-app-shell-no-cross-pillar]
name = web app shell must not import core/tools/executors/safety/host/cli/context/observability/memory/prompts
type = forbidden
source_modules =
    web.app
    web.auth
    web.auth_secrets
    web.errors
    web.rate_limit
    web.static
    web.types
    web.ws
    web.routers
forbidden_modules =
    core
    tools
    executors
    safety
    host
    cli
    context
    observability
    memory
    prompts
; web.slash_candidates_loader 是装配期 loader（同 web.run），
; 仅在 lifespan startup 懒 import，允许触达 context / commands。
ignore_imports =
    web.app -> web.slash_candidates_loader
    web.app -> scheduler.runtime_factory
    web.app -> scheduler.store
    web.app -> scheduler.ticker
    web.app -> scheduler.delivery
    web.app -> evolution.apply_executor
    web.app -> evolution.evolution_manager
    web.routers.threads -> evolution.apply_executor
    web.routers.threads -> evolution.models
    web.routers.threads -> evolution.state_store
    web.routers.threads -> evolution.store
    web.ws -> evolution.state_store
    web.ws -> evolution.store
    web.claude_code.route -> web.ws_event_sink
    web.claude_code.route -> evolution.claude_transcript_provider
    web.claude_code.route -> core.contracts

; ---------------------------------------------------------------------------
; Contract 7: scheduler 不允许 import web 模块
;             scheduler 通过 Protocol（TargetDeliverySink）与 web 解耦；
;             具体实现（ThreadTargetSink）在 web 侧，装配层注入。
; ---------------------------------------------------------------------------

[importlinter:contract:scheduler-no-web]
name = scheduler must not import web
type = forbidden
source_modules =
    scheduler
forbidden_modules =
    web

; ---------------------------------------------------------------------------
; Contract 8: evolution 不允许 import web 模块
;             evolution 通过 TranscriptProvider Protocol 与频道层解耦；
;             唯一例外：claude_evidence_selector -> web.claude_code.jsonl_history
;             （单点白名单，借 jsonl 解析能力）。
; ---------------------------------------------------------------------------

[importlinter:contract:evolution-no-web]
name = evolution must not import web
type = forbidden
source_modules =
    evolution
forbidden_modules =
    web
ignore_imports =
    evolution.claude_evidence_selector -> web.claude_code.jsonl_history

; ---------------------------------------------------------------------------
; Contract 9: usage-token 封装边界
;             ``web.usage_token`` 是 Token 用量的唯一对外入口。
;             外部模块禁止 import 内部子模块（_models / _channel_anthropic /
;             _channel_openai / _persistence / _migration），只能通过
;             ``UsageTokenManager`` + 公共 DTO（UsageTokenSnapshot /
;             ThreadUsageSummary / UsageFrame / ThreadMetadataIO）访问。
;
;             5 大硬性约束的机器强制；详见 docs/usage-token/。
;
;             白名单：
;             - ``web.thread_metadata -> web.usage_token._migration``
;               task#2 阶段 thread_metadata.py 的 lazy upgrade 链需要单点调用
;               ``upgrade_v7_to_v8`` 纯函数（迁移逻辑沉到 _migration 模块）
; ---------------------------------------------------------------------------

[importlinter:contract:usage-token-encapsulation]
name = Only UsageTokenManager v2 and public DTOs exposed; derivers and private models are forbidden
type = forbidden
; allow_indirect_imports=True：只禁直接 import；透过公共入口 web.usage_token_v2 →
; manager.py 间接接触内部模型是合法的（manager 内部消费自家私有 helper）。
allow_indirect_imports = True
source_modules =
    core
    cli
    host
    safety
    observability
    config_loader
    executors
    web.app
    web.routers
    web.cron_delivery
    web.cron_ws
    web.ws
    web.ws_event_sink
    web.thread_metadata
    web.claude_code
    web.codex
    web.protocol
forbidden_modules =
    web.usage_token_v2._derive_claude
    web.usage_token_v2._derive_codex
    web.usage_token_v2._derive_generic
    web.usage_token_v2._models
    web.usage_token_v2._model_context_table
; web.thread_manager 是装配层，允许构造 v2 manager + 注入 locator；
; 但仍禁止直接 import 派生器（manager 内部消费）。
