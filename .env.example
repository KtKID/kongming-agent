# kongming-agent 环境变量模板
#
# 使用方式：
#   1. 复制本文件到 runtime home：  cp .env.example ~/.kongming/.env
#   2. 填入你的真实值（API key 等敏感信息）
#   3. Web 开发环境使用独立 home 时，复制到对应目录，例如 /Users/kid/.kongming-dev/.env
#
# 运行时读取 KONGMING_HOME/.env；load_config() 的第一步就会把本文件注入进程
# 环境变量，再走 KONGMING_* 覆盖链接入 Config。
#
# 完整支持的 env 变量清单见 src/infrastructure/config/loader.py 的 _ENV_FIELD_PATHS 元组。

# --- 默认运行模型选择 ---

# 覆盖 setting.yaml 的 model.preset_id。
KONGMING_MODEL_PRESET_ID=

# 覆盖默认 reasoning 档位：none / low / medium / high / max。
KONGMING_MODEL_REASONING_EFFORT=

# 可选：替换内置 catalog 文件。用户自定义 provider 默认放在
# KONGMING_HOME/model-providers.yaml。
KONGMING_MODEL_PROVIDER_CATALOG=

# --- 其他常用开关（全部可选）---

# 审批模式：interactive（交互确认）/ auto_allow（自动放行）/ auto_deny（自动拒绝）
KONGMING_APPROVAL_MODE=interactive

# Session 存储后端：memory（内存）/ sqlite（SQLite 数据库）/ file（文件系统）
KONGMING_SESSION_BACKEND=memory

# 追加到 system prompt 的临时全局指令，用于在运行时注入额外提示词
KONGMING_EXTRA_INSTRUCTIONS=

# 是否启用 Shell 工具（默认 true，设 false 关闭）
KONGMING_TOOL_SHELL_ENABLED=false

# 是否启用文件读写工具（默认 true，设 false 关闭）
KONGMING_TOOL_FILE_ENABLED=false

# 是否运行真实模型 e2e 测试（默认 skip，设 1 启用）
KONGMING_E2E_REAL_MODEL=1

# 是否保存原始 LLM 请求 / 响应 trace（默认 false）。启用后注意本地日志权限和敏感信息处理
# KONGMING_TRACE_RAW_LLM=false

# --- Web 服务（可选，默认全部关闭 / 走 setting.yaml 默认值）---

# 是否启用 Web 宿主壳（默认 false）
KONGMING_WEB_ENABLED=true

# Web 服务绑定 IP 地址（默认 0.0.0.0，即所有网卡）
KONGMING_WEB_HOST=0.0.0.0

# Web 服务监听端口（默认 8080）
KONGMING_WEB_PORT=8080

# 跳过登录鉴权，仅本地开发使用！上线必须设为 false
KONGMING_WEB_DEV_MODE=true

# 首次部署启动时使用的初始密码。仅在 password.hash 缺失时生效，设置后自动哈希持久化
KONGMING_WEB_INITIAL_PASSWORD=

# 首次部署启动时使用的 Web 登录密码 env。已有 password.hash 时以持久化 hash 为准
# KONGMING_WEB_PASSWORD=

# Cell 空闲超时时间（秒），超过后自动回收资源（下限 60s）
KONGMING_WEB_IDLE_TIMEOUT_SECONDS=1800

# Cell 空闲检查间隔（秒），定时轮询判断是否超时（下限 10s）
KONGMING_WEB_IDLE_CHECK_INTERVAL_SECONDS=60

# 待审批操作超时时间（秒），超时后自动拒绝（下限 10s）
KONGMING_WEB_PENDING_APPROVAL_TIMEOUT_SECONDS=60

# --- Web Provider-Specific API Keys ---
# CLI、Web 与后台任务统一通过 catalog 引用下列 provider-specific key。

# MiniMax M3（Anthropic 兼容接口）API 密钥
MINIMAX_API_KEY=

# 智谱 GLM API 密钥
GLM_API_KEY=

# DeepSeek API 密钥
DEEPSEEK_API_KEY=

# --- Evolution Reviewer ---
# reviewer 子 agent 可选择独立 preset；留空时继承主模型。
KONGMING_EVOLUTION_LEARNING_PRESET_ID=

# reviewer 推理强度（low / medium / high）
KONGMING_EVOLUTION_LEARNING_REASONING_EFFORT=

# reviewer 专用 API 密钥（通过 setting.yaml 的 api_key_env 字段引用此变量名）
EVOLUTION_REVIEWER_API_KEY=
